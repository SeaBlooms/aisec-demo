{
  "name": "aisec-deck",
  "private": true,
  "description": "Marp deck for the AI security panel",
  "scripts": {
    "preview": "marp --theme-set theme.css --preview deck.md",
    "build:html": "marp --theme-set theme.css --html --allow-local-files deck.md -o out/deck.html",
    "build:pdf": "marp --theme-set theme.css --html --allow-local-files --pdf --pdf-notes deck.md -o out/deck.pdf",
    "build:pptx": "marp --theme-set theme.css --html --allow-local-files --pptx deck.md -o out/deck.pptx",
    "build": "npm run build:pdf && npm run build:pptx && npm run build:html"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.2.3"
  },
  "overrides": {
    "basic-ftp": "6.2.4",
    "@puppeteer/browsers": "3.3.0",
    "puppeteer-core": "25.19.0",
    "zod": "4.6.7"
  }
}
